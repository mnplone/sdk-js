{
	"name": "@mnplone/sdk",
	"version": "0.1.0-dev",
	"description": "SDK for M1",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "dist/main.js",
	"types": "dist/main.d.ts",
	"exports": {
		".": "./dist/main.js",
		"./dev": "./dist/dev.js"
	},
	"engines": {
		"node": ">=21"
	},
	"dependencies": {
		"@extws/client": "github:extws-team/client#f506a9ab7b1222936626b327a8760e4977a32f55",
		"valibot": "^1.1.0"
	},
	"devDependencies": {
		"@kirick/eslint-config": "^0.1.30",
		"@types/bun": "1.2.23",
		"@types/node": "^22.2",
		"eslint": "9.8.0",
		"publint": "^0.3.12",
		"tsdown": "0.12.8",
		"tsup": "8.5.0",
		"type-fest": "github:sindresorhus/type-fest#34368551f3d8a13582e8fe7a5378c4d63eb9a744",
		"typescript": "5.8.3",
		"unplugin-unused": "^0.5.0",
		"vitest": "3.2.4",
		"otplib": "^12.0.1"
	},
	"scripts": {
		"build:tsdown": "tsdown src/main.ts src/dev.ts --unused --dts --format esm",
		"build": "find dist/ -mindepth 1 -delete && bun run build:js && bun run build:dts",
		"build:js": "bun build src/main.ts src/dev.ts --outdir=dist --format=esm --splitting --packages=external",
		"build:dts": "tsup --dts-only --format esm src/main.ts src/dev.ts",
		"check": "bun run lint && bun run test && bun run build",
		"lint": "eslint . && tsc && (cd test && tsc)",
		"test": "node --experimental-strip-types test/dist.ts && bun run test/dist.ts && bun test --coverage"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mnplone/sdk-js.git"
	},
	"keywords": [
		"mnplone",
		"sdk"
	],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/mnplone/sdk-js/issues"
	},
	"homepage": "https://github.com/mnplone/sdk-js#readme"
}

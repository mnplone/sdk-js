{
	"name": "@mnplone/sdk",
	"version": "0.1.0-beta.1",
	"description": "SDK for mnpl.one",
	"publishConfig": {
		"access": "public"
	},
	"type": "module",
	"main": "dist/main.js",
	"types": "dist/main.d.ts",
	"exports": {
		".": "./dist/main.js",
		"./dev": "./dist/dev.js"
	},
	"engines": {
		"node": ">=21"
	},
	"dependencies": {
		"@extws/client": "0.2.1-beta.1",
		"valibot": "^1.1.0"
	},
	"devDependencies": {
		"@kirick/eslint-config": "^0.1.30",
		"@types/bun": "^1.2.13",
		"@types/node": "^22.2",
		"eslint": "9.8.0",
		"publint": "^0.3.12",
		"tsdown": "^0.11.9",
		"type-fest": "^4.41.0",
		"typescript": "5.8.3",
		"unplugin-unused": "^0.5.0",
		"vitest": "3.1.3"
	},
	"scripts": {
		"build": "tsdown src/main.ts src/dev.ts --unused --dts --format esm",
		"check": "bun run lint && bun run build && bun run test",
		"lint": "eslint . && tsc --skipLibCheck --noemit",
		"test": "NODE_TLS_REJECT_UNAUTHORIZED=0 bun test --coverage"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mnplone/sdk-js.git"
	},
	"keywords": [
		"mnplone",
		"sdk"
	],
	"author": "Daniil Kirichenko (https://twitter.com/kirickme)",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/mnplone/sdk-js/issues"
	},
	"homepage": "https://github.com/mnplone/sdk-js#readme"
}
